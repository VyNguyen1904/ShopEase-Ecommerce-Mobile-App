		{
			"name": "1. User & Authentication",
			"description": "Endpoints managed by user-service for user registration, token-based login, token refresh, logout, profile updates, and shipping address management.",
			"item": [
				{
					"name": "Register (Buyer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data) {",
									"    if (jsonData.data.accessToken) {",
									"        pm.environment.set(\"access_token\", jsonData.data.accessToken);",
									"    }",
									"    if (jsonData.data.refreshToken) {",
									"        pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"buyer@shopease.local\",\n    \"password\": \"password123\",\n    \"fullName\": \"Jane Buyer\",\n    \"phone\": \"0912345678\",\n    \"role\": \"BUYER\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
