{
	"info": {
		"_postman_id": "shopease-full-suite",
		"name": "ShopEase Full Microservice Suite",
		"description": "Comprehensive testing suite for all ShopEase microservices, including Auth, Catalog, Cart, Saga-based Orders, Payments, and Reviews.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. User & Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success) {",
									"    pm.environment.set(\"access_token\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"buyer@shopease.local\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Product Catalog",
			"item": [
				{
					"name": "List All Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "Search Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/search/products?q=iphone",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"search",
								"products"
							],
							"query": [
								{
									"key": "q",
									"value": "iphone"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Suggestions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/search/suggestions?q=i",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"search",
								"suggestions"
							],
							"query": [
								{
									"key": "q",
									"value": "i"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "List Categories",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Cart Management",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Id",
								"value": "demo-buyer",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/cart",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"cart"
							]
						}
					},
					"response": []
				},
				{
					"name": "Add Item to Cart",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-User-Id",
								"value": "demo-buyer",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"productId\": 1,\n    \"quantity\": 2\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/cart/items",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"cart",
								"items"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Order & Saga Flow",
			"item": [
				{
					"name": "Place Order (Starts Saga)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success) {",
									"    pm.environment.set(\"last_order_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-User-Id",
								"value": "demo-buyer",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"items\": [\n        {\n            \"productId\": 1,\n            \"quantity\": 1\n        }\n    ],\n    \"shipRecipient\": \"John Doe\",\n    \"shipPhone\": \"0987654321\",\n    \"shipStreet\": \"123 Main St\",\n    \"shipDistrict\": \"District 1\",\n    \"shipCity\": \"HCM City\",\n    \"paymentMethod\": \"CARD\",\n    \"note\": \"Handle with care\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/orders",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders"
							]
						}
					},
					"response": []
				},
				{
					"name": "Check Order Saga Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Id",
								"value": "demo-buyer",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/orders/{{last_order_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders",
								"{{last_order_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Simulate Payment Success (Webhook)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/payments/simulate-webhook?orderId={{last_order_id}}&success=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"payments",
								"simulate-webhook"
							],
							"query": [
								{
									"key": "orderId",
									"value": "{{last_order_id}}"
								},
								{
									"key": "success",
									"value": "true"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Deliver Order (Admin/Seller)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/orders/{{last_order_id}}/deliver",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders",
								"{{last_order_id}}",
								"deliver"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Payments",
			"item": [
				{
					"name": "Get Payment Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/payments/status/{{last_order_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"payments",
								"status",
								"{{last_order_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Payment QR Code (SVG)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/payments/qr/{{last_order_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"payments",
								"qr",
								"{{last_order_id}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "6. Reviews",
			"item": [
				{
					"name": "Check Review Eligibility",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Id",
								"value": "demo-buyer",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/orders/{{last_order_id}}/review-eligibility?productId=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders",
								"{{last_order_id}}",
								"review-eligibility"
							],
							"query": [
								{
									"key": "productId",
									"value": "1"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Product Review",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-User-Id",
								"value": "demo-buyer",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"productId\": 1,\n    \"orderId\": \"{{last_order_id}}\",\n    \"rating\": 5,\n    \"title\": \"Great product!\",\n    \"body\": \"The iPhone 15 Pro is amazing. Highly recommend!\",\n    \"imageUrls\": [\"https://example.com/review1.png\"]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/reviews",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"reviews"
							]
						}
					},
					"response": []
				}
			]
		}
	],
